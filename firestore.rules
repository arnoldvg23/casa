rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Camps opcionals: si hi són, han de tenir el tipus i la mida bons.
    function textField(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }
    function boolField(d, key) {
      return !(key in d) || d[key] is bool;
    }
    function timeField(d, key) {
      return !(key in d) || d[key] == null || d[key] is int || d[key] is float;
    }
    function nameField(d, max) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= max;
    }
    // En crear, només els camps que fa servir l'app. En canviar, només es poden
    // tocar aquests camps (els documents antics poden tenir-ne d'altres).
    function onlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function homeExists(home) {
      return exists(/databases/$(database)/documents/households/$(home));
    }

    function validItem(d) {
      return nameField(d, 80) && textField(d, 'qty', 40) && textField(d, 'category', 20)
        && textField(d, 'addedBy', 40) && textField(d, 'uid', 128)
        && boolField(d, 'done') && boolField(d, 'restored')
        && timeField(d, 'doneAt') && timeField(d, 'createdAt');
    }
    function validHistory(d) {
      return nameField(d, 80) && textField(d, 'category', 20)
        && (!('dates' in d) || (d.dates is list && d.dates.size() <= 20))
        && (!('count' in d) || d.count is int)
        && timeField(d, 'lastAt') && timeField(d, 'snoozedUntil');
    }
    function validWish(d) {
      return nameField(d, 80) && textField(d, 'note', 140)
        && (!('priority' in d) || d.priority in ['alta', 'mitjana', 'baixa'])
        && (!('order' in d) || d.order is int || d.order is float)
        && textField(d, 'addedBy', 40) && textField(d, 'uid', 128)
        && boolField(d, 'done') && timeField(d, 'doneAt') && timeField(d, 'createdAt');
    }

    function validGift(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && (!('link' in data) || (data.link is string && data.link.size() <= 1000))
        && (!('photo' in data) || (data.photo is string && data.photo.size() <= 700000))
        && (!('thumb' in data) || (data.thumb is string && data.thumb.size() <= 60000));
    }
    function giftPath(home, gift) {
      return /databases/$(database)/documents/households/$(home)/gifts/$(gift);
    }

    // Finances: una secció i un concepte (o el format antic de tipus i categoria).
    function validMovement(data) {
      return data.amount is int && data.amount > 0 && data.amount <= 100000000
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (
          (data.section in ['menjar', 'fixes', 'compres', 'extres', 'ingressos', 'estalvis']
            && data.name is string && data.name.size() > 0 && data.name.size() <= 80)
          || (data.type in ['in', 'out'] && data.category is string && data.category.size() <= 30)
        )
        && (!('note' in data) || (data.note is string && data.note.size() <= 140));
    }

    // Perfil de cada cuenta (nombre y hogar): solo lo lee y escribe su dueño.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && textField(request.resource.data, 'name', 40)
        && textField(request.resource.data, 'home', 20)
        && timeField(request.resource.data, 'updatedAt');

      // Finances: privadas. Ni la familia ni nadie más puede leerlas.
      match /movements/{movement} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && validMovement(request.resource.data);
      }
    }

    // Nadie puede listar los hogares: para entrar hay que conocer el código.
    match /households/{home} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && onlyKeys(['createdAt']);

      // Compra, historial i llista per a casa: tota la família hi escriu, però
      // només dins d'una llar que existeixi i amb el format que fa servir l'app.
      match /items/{item} {
        allow read, delete: if request.auth != null && homeExists(home);
        allow create: if request.auth != null && homeExists(home) && validItem(request.resource.data)
          && onlyKeys(['name', 'qty', 'category', 'done', 'doneAt', 'addedBy', 'uid', 'createdAt', 'restored']);
        allow update: if request.auth != null && homeExists(home) && validItem(request.resource.data)
          && onlyChanges(['name', 'qty', 'category', 'done', 'doneAt', 'addedBy', 'uid', 'createdAt', 'restored']);
      }
      match /history/{entry} {
        allow read, delete: if request.auth != null && homeExists(home);
        allow create: if request.auth != null && homeExists(home) && validHistory(request.resource.data)
          && onlyKeys(['name', 'category', 'dates', 'count', 'lastAt', 'snoozedUntil']);
        allow update: if request.auth != null && homeExists(home) && validHistory(request.resource.data)
          && onlyChanges(['name', 'category', 'dates', 'count', 'lastAt', 'snoozedUntil']);
      }
      match /wishes/{wish} {
        allow read, delete: if request.auth != null && homeExists(home);
        allow create: if request.auth != null && homeExists(home) && validWish(request.resource.data)
          && onlyKeys(['name', 'note', 'priority', 'order', 'done', 'doneAt', 'addedBy', 'uid', 'createdAt']);
        allow update: if request.auth != null && homeExists(home) && validWish(request.resource.data)
          && onlyChanges(['name', 'note', 'priority', 'order', 'done', 'doneAt', 'addedBy', 'uid', 'createdAt']);
      }
      // Nadal: todos leen todas las listas, pero cada regalo solo lo crea,
      // cambia o borra el dispositivo que lo añadió (su uid no puede cambiar).
      match /gifts/{gift} {
        allow read: if request.auth != null && homeExists(home);
        allow create: if request.auth != null && homeExists(home)
          && request.resource.data.uid == request.auth.uid
          && validGift(request.resource.data);
        allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && validGift(request.resource.data);
        allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

        // La foto gran, a part de la miniatura. Només el dueny del regal la canvia;
        // getAfter perquè es desa en el mateix lot que el regal.
        match /photo/{doc} {
          allow read: if request.auth != null && homeExists(home);
          allow create, update: if request.auth != null && doc == 'full'
            && getAfter(giftPath(home, gift)).data.uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is string && request.resource.data.data.size() <= 700000;
          allow delete: if request.auth != null && get(giftPath(home, gift)).data.uid == request.auth.uid;
        }
      }
      // Cada miembro solo escribe su propio nombre: así tiene su sección aunque esté vacía.
      match /members/{uid} {
        allow read: if request.auth != null && homeExists(home);
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid && homeExists(home)
          && nameField(request.resource.data, 40) && timeField(request.resource.data, 'updatedAt');
      }
      // Cada dispositivo solo escribe su propio token; solo el servidor los lee.
      match /devices/{uid} {
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid && homeExists(home)
          && request.resource.data.token is string && request.resource.data.token.size() <= 4096
          && textField(request.resource.data, 'name', 40) && timeField(request.resource.data, 'updatedAt');
      }
    }
  }
}
